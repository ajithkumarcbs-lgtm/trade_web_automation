# Copy this file to .env and fill it in. Never commit .env.

# --- Telegram: get api_id / api_hash at https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+91XXXXXXXXXX
# Group to follow: the numeric id printed by `python -m tools.telegram_setup`, or its @username.
# Several channels, each traded its own way: copy channels.example.json to channels.json instead
# (then TELEGRAM_CHAT is not needed).
TELEGRAM_CHAT=

# --- AI that reads the tips: groq (text) or openai. Screenshots always go to OpenAI when its key is set
# (Groq has no production vision model); without it, image tips are read as text only.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Alerts to your own Telegram: "me" = Saved Messages, or a chat id
ALERTS=true
ALERT_CHAT=me

# --- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# high = reads small numbers in images reliably; low = far fewer image tokens, may misread odds
OPENAI_IMAGE_DETAIL=high

# --- Betting site
SITE_URL=https://www.iob7.com
SITE_USERNAME=
SITE_PASSWORD=
HEADLESS=false
# Browser the bot drives: chrome or msedge (already installed), or chromium (Playwright download)
BROWSER_CHANNEL=chrome

# --- Safety. DRY_RUN=true fills the bet slip but never clicks "Place Bet".
DRY_RUN=false
# Stake of 1 unit: a tip saying "2 units" bets 2 x UNIT_STAKE; a tip without units bets 1 unit
UNIT_STAKE=100
# Guard against a misread tip, e.g. "1.0" read as 10 units (0 = off)
MAX_UNITS_PER_BET=5
# Optional caps; 0 = off, so bets follow the Telegram post. Book sets and loss cuts are never blocked.
# New trades per day
MAX_BETS_PER_DAY=20
# Sum of worst-case losses of all trades opened today
MAX_DAILY_EXPOSURE=2000
# Worst-case loss of one bet (a lay risks stake x (odds - 1))
MAX_LIABILITY_PER_BET=300
# Only enter trades within this odds range. MAX_ODDS must be above MAX_BACK_ODDS (below) for backs above 10
# to go in as lays. Above ~20 the opponent's lay price moves in big steps (1.04 = back 26, 1.05 = back 21), so
# the odds tolerance decides whether such a tip is taken.
MIN_ODDS=1.10
MAX_ODDS=100
# Accept a live price up to 5% worse than the tipster's price
ODDS_TOLERANCE=0.05
# Or a fixed amount of odds instead (0.4: tip 3.6 accepts a back down to 3.2); 0 = use ODDS_TOLERANCE
ODDS_TOLERANCE_ABS=0
# Testing only: in dry run / signals-only, fill the slip even when the price is too far from the tip.
# Never applies to live bets.
IGNORE_SLIPPAGE=false
# How sure the AI must be that it read the signal correctly (0-1)
MIN_CONFIDENCE=0.7
# Ignore signals older than this (odds move fast)
SIGNAL_MAX_AGE_SECONDS=90
# Ignore the same tip repeated within this window
DUPLICATE_WINDOW_MINUTES=30
# An entry message comes once: if the site can't take it yet (price moved out of range, suspended, slow page),
# the bot keeps retrying every 10 s for up to this many minutes, re-checking the price against the tip each time.
ENTRY_RETRY_MINUTES=5
# A bookset message comes once: if the site refuses ("Your bet is still on going", suspended), the bot keeps
# retrying every 10 s for up to this many minutes, then alerts you to book by hand.
BOOKSET_RETRY_MINUTES=10
# A bookset (not a loss cut) waits up to this long for the Cashout to be green (profit), then books anyway so
# the loss can't grow. 0 = book at once like the tipster. Loss cuts always book at once.
BOOKSET_GREEN_WAIT_SECONDS=120
# true = never book at a loss: booksets AND loss cuts wait for the Cashout to be green; if it never turns
# green within BOOKSET_RETRY_MINUTES the trade stays open and settles at the result (it can then lose the
# whole stake). false = loss cuts book at once like the tipster.
BOOK_ONLY_GREEN=false
# Book a trade automatically once booking it would lock this many units of profit (0 = off)
AUTO_BOOKSET_UNITS=0
# The site takes no back bet above these odds. A back tip above them (or with no back price shown) is placed
# as a lay of the opponent at its lay price right then: back 15 = lay the other side at 1.07, same win, same
# loss. Only in 2-runner markets (not with a Draw). A booking that would need such a back does the same. 0 = off
MAX_BACK_ODDS=10
# A waiting entry ("3 odds pona edunga", "BACK AT Berrettini 3") waits this long for its price, then is missed
CONDITIONAL_ENTRY_MINUTES=90
# No new entries once today's / this week's / this month's result reaches -N units; bookings and loss cuts
# always work. A trade that ran to the end unbooked counts as lost until you /settle it. 0 = off
DAILY_STOP_UNITS=3
WEEKLY_STOP_UNITS=6
MONTHLY_STOP_UNITS=10
# A CONFIRM question (channels.json "confirm") is dropped if you don't answer /yes within this many seconds
CONFIRM_SECONDS=90
# Paper trading (DRY_RUN=true) runs unattended: instead of asking it goes ahead and writes "[live would ask: ...]"
# in the decision. true = ask in paper trading too.
CONFIRM_IN_DRY_RUN=false
# Speech-to-text for voice notes of channels with "voice": true (needs OPENAI_API_KEY; falls back to whisper-1)
TRANSCRIBE_MODEL=gpt-4o-transcribe
# "Bot running" message to your Telegram every N hours, with today's numbers (0 = off)
HEARTBEAT_HOURS=6
MONITOR_SECONDS=20
# Reload the site every N minutes while idle so the login doesn't time out (0 = off)
KEEPALIVE_MINUTES=4
